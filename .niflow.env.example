# niflow connection config — copy to .niflow.env (git-ignored) and fill in.
# Resolution order: defaults < this file < real environment variables.
# File search order: $NIFLOW_CONFIG, ./.niflow.env, ~/.niflow.env.
# Run `niflow doctor` after editing — it tells you what to fix.

# REST base URL — must end in /nifi-api.
NIFLOW_NIFI_HOST=https://localhost:8443/nifi-api

# --- Option A: username/password login (single-user or LDAP) ---
NIFLOW_NIFI_USER=admin
NIFLOW_NIFI_PASSWORD=adminpassword123

# --- Option B: client-certificate (mTLS) — comment out USER/PASSWORD ---
# PEM format; convert a .p12/.pfx first (see docs/work-nifi-setup.md).
#NIFLOW_NIFI_CLIENT_CERT=/home/you/certs/me.cert.pem
#NIFLOW_NIFI_CLIENT_KEY=/home/you/certs/me.key.pem

# --- Server trust ---
# Best: point at the server/CA certificate so TLS is actually verified.
#NIFLOW_NIFI_CA_BUNDLE=/home/you/certs/nifi-ca.pem
# Dev fallback: skip verification entirely (self-signed local instances).
NIFLOW_NIFI_VERIFY_SSL=false

# --- Compatibility baseline ---
# The OLDEST NiFi line your flows must keep working on, whatever you happen to
# be pushing to today. `niflow validate` checks every flow against it by
# default (no flag) and exits non-zero when a property cannot land there —
# because on the server that failure is silent: NiFi files an unknown key away
# as an inert dynamic property and runs the real one at its default.
# Push is never blocked by it; pushing 2.x-only properties to a 2.x server is
# legitimate, so push warns instead. Set to "none" to switch the check off.
NIFLOW_MIN_NIFI_VERSION=1.24
