# Secrets for sensitive NiFi parameters — applied at push time, never committed.
# (Covers per-environment variants like .niflow-secrets.prod.env too. The
# non-sensitive .niflow-params.<env>.env overlays are MEANT to be committed.)
.niflow-secrets*.env

# Python
__pycache__/
*.egg-info/
.pytest_cache/

# Local NiFi container data (mounted volumes)
.nifi-data/

# Claude Code local state (machine-specific permissions, locks)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Automatic pre-push snapshots (niflow rollback restores from here)
.niflow-backups/

# Per-environment connection config (may hold a work password) + TLS material
.niflow.env
*.p12
*.pfx
certs/
